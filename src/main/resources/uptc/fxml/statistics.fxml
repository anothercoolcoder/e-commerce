<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Pestaña de estadísticas del panel de administración (se incluye desde admin.fxml) -->
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="uptc.viewController.StatisticsViewController" fitToWidth="true">
    <VBox spacing="16" styleClass="page">
        <!-- Indicadores generales -->
        <HBox spacing="40">
            <VBox>
                <Label text="%stats.sales"/>
                <Label fx:id="sales" styleClass="price-xl"/>
            </VBox>
            <VBox>
                <Label text="%stats.orders"/>
                <Label fx:id="orders" styleClass="price-xl"/>
            </VBox>
            <VBox>
                <Label text="%stats.ticket"/>
                <Label fx:id="ticket" styleClass="price-xl"/>
            </VBox>
            <VBox>
                <Label text="%stats.units"/>
                <Label fx:id="units" styleClass="price-xl"/>
            </VBox>
        </HBox>

        <!-- Gráficos -->
        <HBox spacing="16">
            <BarChart fx:id="categoryChart" animated="false" legendVisible="false" title="%stats.chart.category"
                      prefHeight="320" HBox.hgrow="ALWAYS">
                <xAxis>
                    <CategoryAxis/>
                </xAxis>
                <yAxis>
                    <NumberAxis/>
                </yAxis>
            </BarChart>
            <BarChart fx:id="customerChart" animated="false" legendVisible="false" title="%stats.chart.customers"
                      prefHeight="320" HBox.hgrow="ALWAYS">
                <xAxis>
                    <CategoryAxis/>
                </xAxis>
                <yAxis>
                    <NumberAxis/>
                </yAxis>
            </BarChart>
        </HBox>

        <!-- Listas -->
        <HBox spacing="40">
            <VBox spacing="6">
                <Label text="%stats.top" styleClass="section-title"/>
                <VBox fx:id="topProducts" spacing="4"/>
            </VBox>
            <VBox spacing="6">
                <Label text="%stats.lowStock" styleClass="section-title"/>
                <VBox fx:id="lowStock" spacing="4"/>
            </VBox>
        </HBox>
    </VBox>
</ScrollPane>
