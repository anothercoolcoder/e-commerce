<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="uptc.viewController.CheckoutViewController" styleClass="shop-root">
    <VBox spacing="14" maxWidth="500" styleClass="page">
        <Button text="%checkout.back" onAction="#back"/>
        <Label text="%checkout.title" styleClass="title"/>
        <Label text="%checkout.steps" styleClass="muted"/>
        <TextField fx:id="address" promptText="%checkout.address"/>
        <Button text="%checkout.confirm" onAction="#pay" styleClass="cta-button"/>
        <Label fx:id="status" wrapText="true"/>
    </VBox>
</StackPane>
