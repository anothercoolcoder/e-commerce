<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="uptc.viewController.RegisterViewController" styleClass="auth-root">
    <VBox alignment="CENTER" spacing="14" maxWidth="380" styleClass="form">
        <Label text="%register.title" styleClass="title"/>
        <TextField fx:id="nameField" promptText="%register.name"/>
        <TextField fx:id="emailField" promptText="%login.email"/>
        <PasswordField fx:id="passwordField" promptText="%login.password"/>
        <Button text="%register.submit" onAction="#register" styleClass="cta-button"/>
        <Button text="%register.back" onAction="#back"/>
        <Label fx:id="errorLabel" styleClass="error"/>
    </VBox>
</StackPane>
