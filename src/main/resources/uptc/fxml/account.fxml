<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="uptc.viewController.AccountViewController" styleClass="shop-root">
    <VBox spacing="14" maxWidth="500" styleClass="page">
        <Button text="← Tienda" onAction="#back"/>
        <Label text="Mi cuenta" styleClass="title"/>
        <Label fx:id="name" styleClass="section-title"/>
        <Label fx:id="email"/>
        <Label fx:id="orders"/>
    </VBox>
</StackPane>
