<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="uptc.viewController.CartViewController" styleClass="shop-root">
    <center>
        <VBox spacing="14" styleClass="page">
            <Button text="%cart.back" onAction="#back"/>
            <Label text="%cart.title" styleClass="title"/>
            <Label fx:id="empty" text="%cart.empty" styleClass="empty"/>
            <VBox fx:id="lines" spacing="10"/>
        </VBox>
    </center>
    <right>
        <VBox spacing="12" prefWidth="280" styleClass="summary">
            <Label text="%cart.summary" styleClass="section-title"/>
            <Label text="%cart.subtotal"/>
            <Label fx:id="subtotal"/>
            <Label text="%cart.tax"/>
            <Label fx:id="tax"/>
            <Label text="%cart.shipping"/>
            <Label fx:id="shipping"/>
            <Label text="%cart.total" styleClass="section-title"/>
            <Label fx:id="total" styleClass="price-xl"/>
            <Button text="%cart.checkout" onAction="#checkout" styleClass="cta-button"/>
        </VBox>
    </right>
</BorderPane>
