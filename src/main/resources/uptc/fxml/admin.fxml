<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="uptc.viewController.AdminViewController" styleClass="shop-root">
    <center>
        <VBox spacing="12" styleClass="page">
            <HBox spacing="10">
                <Button text="← Tienda" onAction="#back"/>
                <Button text="Ver estadísticas" onAction="#openStatistics"/>
            </HBox>
            <Label text="Administración de inventario" styleClass="title"/>
            <TableView fx:id="table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="id" text="SKU"/>
                    <TableColumn fx:id="product" text="Producto" prefWidth="320"/>
                    <TableColumn fx:id="stockColumn" text="Stock"/>
                    <TableColumn fx:id="state" text="Estado"/>
                </columns>
            </TableView>
            <HBox spacing="10">
                <TextField fx:id="stock" promptText="Nuevo stock"/>
                <Button text="Guardar stock" onAction="#saveStock" styleClass="cta-button"/>
                <Button text="Desactivar producto" onAction="#deactivate"/>
            </HBox>
            <Label fx:id="status"/>
        </VBox>
    </center>
</BorderPane>
